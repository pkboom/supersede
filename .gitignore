node_modules/
dist/
.env
.env.*
.omc/

# Persistent app workspace (created by `npm start`).
workspace/

# Legacy dev workspace from the pre-`npm start` shape; harmless to leave listed.
.dev-workspace/

# Vite intermediate build (web/ source-level output, if any)
web/dist/

# SQLite data dir (per-deploy persistent disk; never committed).
data/

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo

# Scratch directories used by review/verification agents. Never source.
.verif-probe/

# The .plan/ design docs ARE committed — they carry the reasoning behind
# decisions ideas/PLAN-design-system.md only states the conclusion of, and a
# decision whose reasoning is untracked becomes folklore. Throwaway probe
# scripts stay ignored: they are one-shot diagnostics, and .plan/scratch has
# its own vitest.config.ts that must never be collected by the real suite.
.plan/scratch/
